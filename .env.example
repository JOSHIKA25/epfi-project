# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Local sequential agents are the default. Set CREWAI_MODE="remote" to opt into Python CrewAI.
# Configure a provider credential only for remote mode.
CREWAI_SERVICE_URL="http://127.0.0.1:8000"
CREWAI_MODE="local"
CREWAI_MODEL="openai/gpt-4o-mini"
# Optional local Python service used by the benchmark CSV XGBoost + TreeSHAP path.
XGBOOST_SERVICE_URL="http://127.0.0.1:8000"
# Minimum time between live plant-event CrewAI chains (15 minutes by default).
CREWAI_EVENT_COOLDOWN_MS="900000"
# Print detailed inputs/outputs for each sequential step in the app's server terminal.
AGENT_TRACE="false"
OPENAI_API_KEY=""
GROQ_API_KEY=""

# Optional Neo4j Aura or self-hosted Neo4j connection.
# When all three credentials are set, the app verifies connectivity and idempotently
# seeds its TEP prototype graph at server startup.
NEO4J_URI=""
NEO4J_USERNAME=""
NEO4J_PASSWORD=""
NEO4J_DATABASE="neo4j"

# Optional n8n webhook used for maintenance and alert dispatch.
N8N_WEBHOOK_URL=""

# Optional offline TEP run-level calibration for the live MLP autoencoder.
# Leave disabled unless using the matching saved model and benchmark data.
# This does not validate thresholds for the simplified live simulator.
TEP_AE_APPLY_RUN_CALIBRATION="false"

# Initial local FYP demo admin account. Set both before starting the app.
# The password must be at least 12 characters; it is hashed before it is stored.
AUTH_ADMIN_EMAIL="admin@example.local"
AUTH_ADMIN_PASSWORD="CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
