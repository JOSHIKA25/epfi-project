{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "crew:dev": "python -m uvicorn crew_service.main:app --host 127.0.0.1 --port 8000",
    "ml:service": "python -m uvicorn crew_service.main:app --host 127.0.0.1 --port 8000",
    "test:crew": "python -m unittest discover -s crew_service/tests",
    "test:unit-agents": "node --import tsx --test server/tep/unitAgents.test.ts",
    "test:api": "node --import tsx --test src/services/api.test.ts",
    "ml:train-autoencoder": "python -m crew_service.train_autoencoder",
    "ml:train-pca": "python -m crew_service.train_pca_detector",
    "ml:train-fault-classifier": "python -m crew_service.train_fault_classifier",
    "ml:train-xgboost": "python -m crew_service.train_xgboost_classifier",
    "evaluate:autoencoder": "node --import tsx server/ml/evaluateAutoencoder.ts",
    "evaluate:tep-csv": "node --import tsx server/ml/evaluateTepCsv.ts",
    "test:tep-csv-evaluation": "node --import tsx --test server/ml/evaluateTepCsv.test.ts server/ml/tepFaultClassifier.test.ts",
    "test:autoencoder": "node --import tsx --test server/ml/autoencoder.test.ts",
    "test:models": "node --import tsx --test server/ml/physicsSignaturePredictor.test.ts",
    "test:telemetry-csv": "node --import tsx --test src/services/telemetryCsv.test.ts",
    "test:knowledge-exports": "node --import tsx --test src/services/knowledgeExports.test.ts",
    "test:neo4j": "node --import tsx --test server/kg/neo4jGraph.test.ts",
    "neo4j:check": "node --import tsx scripts/validateNeo4j.ts",
    "evaluate:model": "node --import tsx server/ml/evaluatePhysicsSignatureModel.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "neo4j-driver": "^6.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
